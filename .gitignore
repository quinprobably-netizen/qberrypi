/target/
/out/
/vendor-cache/
# The parallel worktrees link vendor-cache to the main checkout's; a link is not a directory.
/vendor-cache
/.superpowers/
/.claude/settings.local.json

# Holds the Wi-Fi passphrase. Use qberrypi.example.toml as the template.
qberrypi.toml

# Holds the API's TLS private key, made once by `cargo xtask make-cert`; the `*` covers the
# temporary name it is written under.
/qberrypi-tls.pem*

# Private outputs (card images and card backups): they hold the Wi-Fi passphrase and the API's
# key. The folder is made with mode 0700 and its files with 0600.
/private/
